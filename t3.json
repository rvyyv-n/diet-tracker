{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "public/assets/icon-dark.svg",
  "scripts": [
    {
      "name": "Worktree Setup",
      "command": "npm ci",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Dev",
      "command": "npm run dev -- --port 5199 --strictPort",
      "icon": "play",
      "stopOnSettle": true,
      "previewUrl": "http://localhost:5199",
      "autoOpenPreview": true
    },
    {
      "name": "Check",
      "command": "npm run check",
      "icon": "lint"
    },
    {
      "name": "Test",
      "command": "npm test",
      "icon": "test"
    },
    {
      "name": "Test Visual",
      "command": "npm run test:visual",
      "icon": "test"
    },
    {
      "name": "Test Offline",
      "command": "npm run test:offline",
      "icon": "test"
    }
  ]
}
