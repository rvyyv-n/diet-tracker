{
  "name": "rise-diet-tracker",
  "private": true,
  "version": "2.3.0",
  "description": "A local-first diet tracker and planner built on fixed meal blocks and weekly trend adjustments.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "vitest run && eslint . && prettier --check . --log-level warn && vite build"
  },
  "dependencies": {
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "vite": "^8.2.2",
    "vitest": "^5.0.1"
  }
}
