# ---- Personal data -------------------------------------------------
# The app is public; the author's real figures are not. Anything holding
# a real profile, weight history, or the source plan documents stays local.
profile.local.json
data.local.json
/private/

# Source plan documents — contain personal health data
*.docx
*.xlsx

# ---- Environment ---------------------------------------------------
node_modules/
.env
.env.*
__pycache__/
*.pyc

# ---- Android release signing ---------------------------------------
# The signing keystore never gets committed. CI reads it from a repo
# secret (see .github/workflows/android.yml); local Gradle builds fall
# back to an unsigned/debug build if it's missing.
android/keystore/*.keystore
android/keystore/*.jks
android/local.properties
android/**/build/
android/.gradle/

# Generated at build time by app/build.gradle.kts (copyWebAssets) and by
# android.yml (rasterising assets/icon.svg) — not the source of truth, so
# not tracked.
android/app/src/main/assets/
android/app/src/main/res/mipmap-*/

# ---- OS / editor ---------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# ---- Tooling -----------------------------------------------------
# Per-machine Claude Code settings (permission grants etc.); the shared
# .claude/settings.json, if one is ever added, stays tracked.
.claude/settings.local.json

# ---- Local scratch ----------------------------------------------
# Loose screenshots / notes that land in the repo root but aren't part
# of the project.
/restore-instructions.png

# Project brief — kept local for now
CLAUDE.md
