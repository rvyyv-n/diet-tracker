#!/bin/sh
#
# post-commit — pin every commit to 12:00:00 +0000 on its own calendar date so
# the machine's timezone offset and time-of-day never land in a public history.
#
# Fires for `git commit` (incl. --amend, cherry-pick, merge); not for commits
# replayed by `git rebase`. One-time setup per clone (the setting is local and
# cannot itself be committed):
#
#     git config core.hooksPath .githooks
#
# DT_TZ_HOOK guards the nested amend from re-entering this hook.

[ -n "$DT_TZ_HOOK" ] && exit 0

day=$(git log -1 --format=%ad --date=format:%Y-%m-%d)
neutral="$day 12:00:00 +0000"

DT_TZ_HOOK=1 \
GIT_AUTHOR_DATE="$neutral" \
GIT_COMMITTER_DATE="$neutral" \
  git commit --amend --no-edit --allow-empty --date="$neutral" >/dev/null 2>&1
